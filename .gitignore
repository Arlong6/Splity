# Xcode build artifacts
build/
DerivedData/
*.xcuserstate
*.moved-aside

# User-specific Xcode state
xcuserdata/

# Firebase config — contains project keys. Ignored by default; if this is a
# private repo and you want it tracked, add it explicitly: git add -f GoogleService-Info.plist
GoogleService-Info.plist

# Test / screenshot output
Screenshots/

# Stray root artifact (empty plist)

.DS_Store

# Python
__pycache__/
*.py[cod]

# Secrets — App Store Connect API key, signing certs/profiles, env files
.env
.env.*
*.p8
*.pem
*.p12
*.cer
*.mobileprovision
*-firebase-adminsdk-*.json
*service-account*.json
serviceAccount*.json

# Exported app archives
*.ipa
*.xcarchive/
