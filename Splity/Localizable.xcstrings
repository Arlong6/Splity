        }
      }
    },
    "「%@」": {
      "comment": "A text view displaying the name of the item or expense that the action was performed on. The text inside the quotation marks should match the `target` field in the `ActivityEntry` model.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」"
          }
        }
      }
    },
    "「%@」刪除後無法復原": {
      "comment": "An alert message that appears when a user attempts to delete an expense, explaining that the deletion cannot be undone.",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" cannot be undone after deletion"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」刪除後無法復原"
          }
        }
      }
    },
    "「%@」將移至已刪除，可在歷史紀錄中還原": {
      "comment": "An alert message inside the \"確定刪除？\" alert, showing the title of the expense that is about to be deleted.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will move to Deleted. You can restore it from the history."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」將移至已刪除，可在歷史紀錄中還原"
          }
        }
      }
    },
    "「%@」會被永久刪除。": {
      "comment": "A message in an alert that informs the user that a group will be permanently deleted. The placeholder text inside the double quotes should be replaced with the name of the group.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be permanently deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」會被永久刪除。"
          }
        }
      }
    },
    "・%@": {
      "comment": "A text element displaying the date and time when a previously deleted expense was restored.",
